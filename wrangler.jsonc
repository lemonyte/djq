{
    "name": "djq",
    "main": "src/index.ts",
    "compatibility_date": "2026-11-01",
    "assets": {
        "directory": "public",
        "binding": "ASSETS",
    },
    "durable_objects": {
        "bindings": [
            {
                "name": "ROOM",
                "class_name": "Room",
            },
        ],
    },
    "migrations": [
        {
            "tag": "v1",
            "new_sqlite_classes": ["Room"],
        },
    ],
    "observability": {
        "enabled": true,
    },
    "workers_dev": false,
    "preview_urls": true,
}
